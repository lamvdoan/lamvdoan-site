<header class="blog-header py-3">
  <div class="align-items-center">
    <p class="blog-header-title"><%= @title_on_header %></p>
  </div>

  <% if controller_path == "blogs" && action_name == "index" %>
    <%= form_with url: blogs_path, method: :get, local: true, data: { blog_search: true }, html: { role: "search", class: "mb-3" } do |form| %>
      <%= form.label :q, "Search blog titles", for: "blog-search-query", class: "visually-hidden" %>
      <div class="input-group">
        <%= form.text_field :q, id: "blog-search-query", value: @query,
            class: "form-control", placeholder: "🔎 Search blog titles",
            inputmode: "search", enterkeyhint: "search", aria: { controls: "blog-search-results" } %>
        <button type="button" class="btn btn-outline-secondary" aria-label="Clear search" data-blog-search-clear>⌫</button>
      </div>
      <p class="text-danger mb-0" role="status" data-blog-search-status></p>
    <% end %>
  <% end %>

  <% if user_signed_in? %>
    <%= link_to 'New Blog', new_blog_path %>
  <% end %>
</header>
